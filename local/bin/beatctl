#!/usr/bin/env python3
"""beatctl -- talk to a running beatd.

  beatctl status     one-shot: is it up, what's playing, current BPM
  beatctl waybar     continuous JSON lines for a waybar custom module
  beatctl watch      human-readable live meter (for tuning sensitivity)
"""
from __future__ import annotations

import argparse
import asyncio
import json
import sys
from pathlib import Path

try:
    import websockets
except ImportError:
    sys.exit("beatctl: python3 'websockets' module missing")

CONFIG_F = Path.home() / ".config" / "beatsync" / "config.json"
BLOCKS = " ▁▂▃▄▅▆▇█"


def port() -> int:
    try:
        return int(json.loads(CONFIG_F.read_text()).get("port", 8787))
    except Exception:
        return 8787


def bars(spec: list[float], n: int = 8) -> str:
    """Down-mix the spectrum to n block characters."""
    if not spec:
        return " " * n
    step = max(1, len(spec) // n)
    out = []
    for i in range(n):
        chunk = spec[i * step:(i + 1) * step] or [0.0]
        v = sum(chunk) / len(chunk)
        out.append(BLOCKS[min(len(BLOCKS) - 1, int(v * (len(BLOCKS) - 1) + 0.5))])
    return "".join(out)


async def stream(mode: str, fps: float) -> None:
    uri = f"ws://127.0.0.1:{port()}"
    period = 1.0 / fps
    while True:
        try:
            async with websockets.connect(uri, ping_interval=20) as ws:
                track, last = {}, 0.0
                async for raw in ws:
                    msg = json.loads(raw)
                    if msg.get("t") == "palette":
                        track = msg.get("track", {})
                        continue
                    if msg.get("t") != "f":
                        continue
                    now = asyncio.get_event_loop().time()
                    if now - last < period:
                        continue
                    last = now

                    glyphs = bars(msg.get("spec", []))
                    bpm = msg.get("bpm") or 0
                    title = track.get("title") or "—"
                    artist = track.get("artist") or ""
                    tip = f"{artist} — {title}" if artist else title
                    if bpm:
                        tip += f"\n{bpm:g} BPM"

                    if mode == "waybar":
                        cls = "beat" if msg.get("beat", 0) > 0.55 else "idle"
                        print(json.dumps({
                            "text": glyphs, "class": cls, "tooltip": tip,
                            "percentage": int(msg.get("bass", 0) * 100),
                        }), flush=True)
                    else:
                        print(
                            f"\r{glyphs}  bass {msg.get('bass',0):.2f}  "
                            f"beat {msg.get('beat',0):.2f}  {bpm:>5g} BPM  "
                            f"beats:{msg.get('n',0):<6} {tip[:40]:<40}",
                            end="", flush=True,
                        )
        except Exception:
            if mode == "waybar":
                print(json.dumps({"text": "", "class": "off",
                                  "tooltip": "beatd not running"}), flush=True)
            await asyncio.sleep(3)


async def status() -> None:
    uri = f"ws://127.0.0.1:{port()}"
    try:
        async with websockets.connect(uri, open_timeout=3) as ws:
            pal = frame = None
            for _ in range(200):
                msg = json.loads(await asyncio.wait_for(ws.recv(), timeout=3))
                if msg.get("t") == "palette":
                    pal = msg
                elif msg.get("t") == "f":
                    frame = msg
                if pal and frame:
                    break
    except Exception as exc:
        sys.exit(f"beatd not reachable on {uri} ({exc})")

    tr = (pal or {}).get("track", {})
    acc = (pal or {}).get("accent", {})
    print(f"beatd      running on {uri}")
    print(f"playing    {tr.get('artist','—')} — {tr.get('title','—')}  [{tr.get('status','?')}]")
    print(f"accent     {acc.get('primary','?')}  (album art: "
          f"{'yes' if (pal or {}).get('art_accent') else 'no, wallpaper only'})")
    print(f"bpm        {(frame or {}).get('bpm') or '—'}")
    print(f"beats seen {(frame or {}).get('n', 0)}")


def main() -> None:
    ap = argparse.ArgumentParser(prog="beatctl")
    ap.add_argument("mode", choices=["status", "waybar", "watch"], nargs="?", default="status")
    ap.add_argument("--fps", type=float, default=12.0, help="update rate for waybar/watch")
    args = ap.parse_args()
    try:
        if args.mode == "status":
            asyncio.run(status())
        else:
            asyncio.run(stream(args.mode, args.fps))
    except KeyboardInterrupt:
        print()


if __name__ == "__main__":
    main()
