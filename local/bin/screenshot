#!/usr/bin/env bash
# screenshot [full|region|window]  -> saves to ~/Pictures/Screenshots and copies to clipboard
set -euo pipefail

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"

case "${1:-full}" in
    full)
        grim "$FILE"
        ;;
    region)
        # slurp exits non-zero if you press Escape -- don't leave an empty file.
        geom=$(slurp) || exit 0
        grim -g "$geom" "$FILE"
        ;;
    window)
        # With no focused window hyprctl returns {}, and jq would emit
        # "null,null nullxnull" -- grim then fails with a confusing error.
        geom=$(hyprctl activewindow -j 2>/dev/null \
               | jq -r 'if .at then "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])" else empty end')
        [ -n "$geom" ] || { echo "no focused window" >&2; exit 1; }
        grim -g "$geom" "$FILE"
        ;;
    *)
        echo "usage: screenshot [full|region|window]" >&2; exit 1
        ;;
esac

wl-copy < "$FILE"
command -v notify-send >/dev/null 2>&1 && notify-send "Screenshot" "$(basename "$FILE")" 2>/dev/null || true
echo "$FILE"
