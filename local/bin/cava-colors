#!/usr/bin/env python3
"""Rewrite ~/.config/cava/config's [color] section from the pywal palette.
Background stays 'default' so the terminal's transparency shows through."""
import os, re, pathlib

home = pathlib.Path.home()
palette = home / ".cache/wal/colors"
cfg = home / ".config/cava/config"
if not palette.exists():
    raise SystemExit("no pywal palette yet")

cols = [l.strip() for l in palette.read_text().splitlines()
        if re.fullmatch(r"#[0-9a-fA-F]{6}", l.strip())]

def luma(h):
    r, g, b = (int(h[i:i+2], 16) for i in (1, 3, 5))
    return 0.2126*r + 0.7152*g + 0.0722*b

# color1..color6 + foreground, dimmest -> brightest, deduped.
stops = sorted({c for c in cols[1:7]} | {cols[7]}, key=luma)
while len(stops) < 8:                 # pad if the image was low-contrast
    stops.append(stops[-1])
stops = stops[:8]

color = ["[color]", "background = default", "foreground = default",
         "gradient = 1", "gradient_count = 8"]
color += [f"gradient_color_{i} = '{c}'" for i, c in enumerate(stops, 1)]
block = "\n".join(color) + "\n"

text = cfg.read_text() if cfg.exists() else ""
if "[color]" in text:
    text = re.sub(r"\[color\][\s\S]*?(?=\n\[|\Z)", block.rstrip() + "\n", text)
else:
    text = text.rstrip() + "\n\n" + block
cfg.parent.mkdir(parents=True, exist_ok=True)
cfg.write_text(text)
print("cava gradient:", " ".join(stops))
