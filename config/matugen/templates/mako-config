# ~/.config/mako/config -- GENERATED BY MATUGEN. Do not edit here.
# Source template: ~/.config/matugen/templates/mako-config
#
# Colour roles are deliberately the same ones the island and rofi use
# (surface_container for the pane, on_surface for type) so a notification
# reads as the same material as the rest of the shell.
#
# The pane is translucent and leans on Hyprland's blur layer rule for the
# `notifications` namespace -- same trick as the island. Without that rule
# this will look washed out over a busy wallpaper.

# ---- placement ----------------------------------------------------------
# Waybar already reserves its own exclusive zone, so mako is pushed below the
# bar for free -- outer-margin only has to add the gutter on top of that.
# Right gutter is 10px, matching the bar's own side margin.
anchor=top-right
layer=overlay
outer-margin=8,10,10,10
margin=10
max-visible=5
sort=-time

# ---- geometry -----------------------------------------------------------
width=390
height=180
padding=14,18
border-size=1
border-radius=18
icon-location=left
max-icon-size=44

# ---- type ---------------------------------------------------------------
# Same family as waybar/kitty/fuzzel. Pango format, so no ':size='.
font=JetBrainsMono Nerd Font 10
text-alignment=left
markup=1
format=<b>%s</b>\n%b

# ---- behaviour ----------------------------------------------------------
default-timeout=6000
ignore-timeout=0
actions=1
history=1
max-history=30
on-button-left=invoke-default-action
on-button-middle=dismiss
on-button-right=dismiss-all
on-touch=dismiss

# ---- colour (wallpaper palette) -----------------------------------------
background-color=#{{colors.surface_container.default.hex_stripped}}a6
text-color=#{{colors.on_surface.default.hex_stripped}}ff
border-color=#{{colors.on_surface.default.hex_stripped}}26
progress-color=over #{{colors.primary.default.hex_stripped}}33

# ---- urgency ------------------------------------------------------------
# Low: recedes -- dimmer type, barely-there edge, shorter dwell.
[urgency=low]
background-color=#{{colors.surface_container_low.default.hex_stripped}}99
text-color=#{{colors.on_surface_variant.default.hex_stripped}}ff
border-color=#{{colors.on_surface.default.hex_stripped}}14
default-timeout=4000

# Normal: the accent edge is the only saturated thing on the pane.
[urgency=normal]
background-color=#{{colors.surface_container.default.hex_stripped}}a6
text-color=#{{colors.on_surface.default.hex_stripped}}ff
border-color=#{{colors.primary.default.hex_stripped}}4d

# Critical: error container, a full-strength border, and it never expires.
[urgency=critical]
background-color=#{{colors.error_container.default.hex_stripped}}d9
text-color=#{{colors.on_error_container.default.hex_stripped}}ff
border-color=#{{colors.error.default.hex_stripped}}ff
border-size=2
progress-color=over #{{colors.error.default.hex_stripped}}40
default-timeout=0

# ---- modes --------------------------------------------------------------
# KEEP. The dynamic island's DND toggle is `makoctl mode -a do-not-disturb`
# (island.py, Dnd class) and it is a no-op unless this block exists.
[mode=do-not-disturb]
invisible=1
