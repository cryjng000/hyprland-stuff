/* Local additions on top of the KooL rice — kept here so the upstream
   Modules/ModulesCustom/ModulesGroups files stay untouched and updatable. */
{

/* ---- dynamic island -------------------------------------------------- */
/* group/island is one pill. The collapsed half is custom/island (music when
   something is playing, system stats otherwise); hovering slides out the
   detail modules to its right. */

"group/island": {
	"orientation": "horizontal",
	"drawer": {
		"transition-duration": 350,
		"children-class": "island-child",
		"transition-left-to-right": true,
	},
	"modules": [
		"custom/island",
		"network#island",
		"cpu#island",
		"memory#island",
		"temperature#island",
		"disk#island",
	],
},

"custom/island": {
	"exec": "$HOME/.config/waybar/scripts/island.sh",
	"return-type": "json",
	"format": "{}",
	"escape": false,          // the script emits its own pango-escaped text
	"tooltip": true,
	"on-click": "playerctl -p spotify,%any play-pause",
	"on-click-right": "playerctl -p spotify,%any next",
	"on-click-middle": "playerctl -p spotify,%any previous",
},

"network#island": {
	"format": "󰌘 {ipaddr}",
	"format-wifi": "{icon} {essid}",
	"format-ethernet": "󰌘 {ipaddr}",
	"format-linked": "󰈁 {ifname}",
	"format-disconnected": "󰌙 offline",
	"interval": 5,
	"format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
	"tooltip-format": "{ifname}\n{ipaddr}\n󰅧 {bandwidthUpBits}  󰅢 {bandwidthDownBits}",
	"tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}\n󰅧 {bandwidthUpBits}  󰅢 {bandwidthDownBits}",
	"tooltip-format-disconnected": "󰌙 Disconnected",
	"on-click-right": "$HOME/.config/hypr/scripts/WaybarScripts.sh --nmtui",
},

"cpu#island": {
	"format": "󰍛 {usage}%",
	"interval": 2,
	"tooltip": true,
	"on-click-right": "gnome-system-monitor",
},

"memory#island": {
	"format": "󰾆 {used:0.1f}G",
	"interval": 5,
	"tooltip": true,
	"tooltip-format": "{used:0.1f}G / {total:0.1f}G  ({percentage}%)",
},

"temperature#island": {
	/* by-path rather than hwmonN: the numbering shuffles across boots and the
	   stock module was pointing at the nvme sensor, not the CPU */
	"hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
	"input-filename": "temp1_input",
	"interval": 5,
	"critical-threshold": 85,
	"format": "󰔐 {temperatureC}°",
	"format-critical": "󰸁 {temperatureC}°",
	"tooltip-format": "CPU package {temperatureC}°C",
},

"disk#island": {
	"format": "󰋊 {percentage_used}%",
	"path": "/",
	"interval": 30,
	"tooltip-format": "{used} of {total} used on {path}",
},

}
