/* My Mostly Used waybar config incase you wonder :) */
{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"layer": "bottom",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 4,
"fixed-center": true,
"ipc": true,
"margin-top": 3,
"margin-left": 8,
"margin-right": 8,

"modules-left": [
	"clock",
	"custom/separator#blank",
	"group/app_drawer",
	"custom/separator#dot-line",
	"hyprland/workspaces#kanji",
	],

/* deliberately empty: the floating dynamic island (~/.config/island) owns
   this gap and would sit on top of anything placed here */
"modules-center": [
	],

"modules-right": [
        //"mpris",
        //"custom/separator#dot-line",
	"custom/separator#blank",
	"custom/beatsync",
	"custom/separator#dot-line",
	"group/audio",
	"custom/separator#dot-line",
	"group/notify",
	"custom/separator#blank",
	"tray",
	"custom/separator#blank",
	"group/status",
	],
}
